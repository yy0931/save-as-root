{
  "name": "sudo-remote-ssh",
  "displayName": "Sudo Remote - SSH",
  "description": "Edit configuration files with root privileges while using VS Code Remote - SSH extension.",
  "version": "1.0.2",
  "publisher": "rezbouchabou",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rezbouchabou/save-as-root"
  },
  "bugs": {
    "url": "https://github.com/rezbouchabou/save-as-root/issues"
  },
  "homepage": "https://github.com/rezbouchabou/save-as-root",
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "remote",
    "ssh",
    "root",
    "sudo",
    "remote-ssh",
    "linux"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sudo-remote-ssh.saveFile",
        "title": "Save as Root"
      },
      {
        "command": "sudo-remote-ssh.saveFileAsSpecifiedUser",
        "title": "Save as Specified User…"
      },
      {
        "command": "sudo-remote-ssh.newFile",
        "title": "New File as Root..."
      }
    ],
    "configuration": {
      "title": "Save as Root",
      "properties": {
        "sudo-remote-ssh.command": {
          "type": "string",
          "default": "sudo",
          "description": "Command used to elevate privileges."
        },
        "sudo-remote-ssh.extensionsToNotifyOnSave": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pucelle.run-on-save"
          ],
          "markdownDescription": "List of extension IDs to notify after saving."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "sudo-remote-ssh.newFile",
          "group": "navigation@9",
          "when": "resourceScheme == file && explorerResourceIsFolder && remoteName != ''"
        }
      ]
    }
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "sudo-remote-ssh.command"
      ]
    }
  }
}