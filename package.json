{
	"name": "save-as-root",
	"displayName": "Save as Root in Remote - SSH",
	"description": "Edit configuration files with root privileges while using the Remote - SSH extension",
	"version": "1.11.0",
	"publisher": "yy0931",
	"engines": {
		"vscode": "^1.100.0"
	},
	"repository": {
		"url": "https://github.com/yy0931/save-as-root",
		"type": "git"
	},
	"bugs": {
		"url": "https://github.com/yy0931/save-as-root/issues"
	},
	"icon": "icon.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"keywords": [
		"remote",
		"ssh",
		"root",
		"sudo"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "save-as-root.saveFile",
				"title": "Save as Root"
			},
			{
				"command": "save-as-root.saveFileAsSpecifiedUser",
				"title": "Save as Specified User…"
			},
			{
				"command": "save-as-root.newFile",
				"title": "New File as Root...",
				"enablement": "sqlite3-editor.activeFeatures.newFileAsRoot"
			}
		],
		"configuration": {
			"properties": {
				"save-as-root.command": {
					"type": "string",
					"default": "sudo"
				},
				"save-as-root.optionalFeatures": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": ["new-file-as-root", "open-as-root"]
					},
					"default": ["new-file-as-root", "open-as-root"],
					"markdownDescription": "Changing this setting requires reopening the window to take effect."
				}
			}
		},
		"menus": {
			"explorer/context": [
				{
					"command": "save-as-root.newFile",
					"group": "navigation@9",
					"when": "resourceScheme == file && explorerResourceIsFolder && remoteName != '' && sqlite3-editor.activeFeatures.newFileAsRoot"
				}
			]
		}
	},
	"capabilities": {
		"virtualWorkspaces": false,
		"untrustedWorkspaces": {
			"supported": "limited",
			"restrictedConfigurations": [
				"save-as-root.command"
			]
		}
	}
}
